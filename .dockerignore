# Build context allowlist. Everything else stays outside Docker.
**

# Dependency manifests and application configuration.
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!astro.config.ts
!svelte.config.ts
!tsconfig.json
!keystatic.config.ts

# Tailwind uses .gitignore to determine which sources to scan.
!.gitignore

# Application sources and build-time content.
!src/**
!content/**
!messages/**
!public/**
!scripts/content/**
!scripts/i18n/**
!scripts/prune-assets.ts

# Runtime configuration is copied separately from the application sources.
!Caddyfile

# Only reusable Astro image and font caches, never installed dependencies.
!node_modules/.astro/assets/**
!node_modules/.astro/fonts/**

# Regenerate declarations during preparation; tests are not part of the build.
**/*.d.json.ts
**/*.test.*
