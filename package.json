{
	"name": "@acdh-oeaw/ai-meets-hss-website",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": "^26"
	},
	"packageManager": "pnpm@12.23.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.23.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "^26",
			"onFail": "download"
		}
	},
	"scripts": {
		"app:build": "astro build",
		"app:dev": "astro dev",
		"build": "run-s content:build app:build",
		"content:build": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx ./scripts/content/generate-content.ts build",
		"content:dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx ./scripts/content/generate-content.ts watch",
		"dev": "concurrently --kill-others --names \"content,app\" --prefix-colors \"auto\" \"pnpm:content:dev\" \"pnpm:app:dev\"",
		"format:check": "oxfmt --check .",
		"format:fix": "oxfmt --write .",
		"i18n:prepare": "tsx ./scripts/i18n/generate-types.ts",
		"lint:check": "run-p --continue-on-error \"lint:*:check\"",
		"lint:fix": "run-p --continue-on-error \"lint:*:fix\"",
		"lint:code:check": "oxlint --type-aware .",
		"lint:code:fix": "pnpm run lint:code:check --fix",
		"lint:styles:check": "stylelint \"./src/styles/**/*.@(astro|css)\" --cache --ignore-path ./.gitignore",
		"lint:styles:fix": "pnpm run lint:styles:check --fix",
		"preinstall": "npx only-allow pnpm",
		"prepare": "run-s setup types:prepare",
		"setup": "is-in-ci || lefthook install",
		"start": "astro preview",
		"sync": "astro sync",
		"test:e2e": "playwright test --config ./e2e/playwright.config.ts",
		"test:e2e:codegen": "playwright codegen",
		"test:e2e:install": "playwright install --with-deps",
		"test:e2e:ui": "pnpm run test:e2e --ui",
		"test:e2e:update-snapshots": "pnpm run test:e2e --update-snapshots",
		"types:check": "astro check && svelte-check --no-tsconfig",
		"types:prepare": "ENV_VALIDATION=\"disabled\" run-s i18n:prepare sync"
	},
	"dependencies": {
		"@acdh-oeaw/keystatic-lib": "^0.8.2",
		"@acdh-oeaw/lib": "^0.3.5",
		"@acdh-oeaw/mdx-lib": "^0.2.0",
		"@acdh-oeaw/style-variants": "^0.1.0",
		"@acdh-oeaw/validate-env": "^0.4.0",
		"@astrojs/sitemap": "^3.7.6",
		"@astrojs/svelte": "^9.1.6",
		"@floating-ui/dom": "^1.7.4",
		"@iconify-json/lucide": "^1.2.77",
		"@keystatic/core": "^0.6.10",
		"@mdx-js/mdx": "^3.1.1",
		"astro": "^7.4.13",
		"astro-icon": "^1.1.5",
		"clsx": "^2.1.1",
		"image-size": "^2.0.2",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-gfm": "^4.0.1",
		"remark-smartypants": "^3.0.2",
		"sharp": "^0.35.5",
		"svelte": "^5.45.4",
		"use-intl": "^4.5.8",
		"valibot": "^1.2.0",
		"vfile": "^6.0.3",
		"vite": "^8.3.8"
	},
	"devDependencies": {
		"@acdh-oeaw/content-lib": "^0.2.0",
		"@acdh-oeaw/stylelint-config": "^4.0.0",
		"@acdh-oeaw/tsconfig": "^1.5.1",
		"@astrojs/check": "^0.9.6",
		"@astrojs/compiler-rs": "^0.5.3",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/react": "^7.1.9",
		"@astrojs/ts-plugin": "^1.10.6",
		"@keystatic/astro": "^6.0.0",
		"@playwright/test": "^1.57.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/hast": "^3.0.4",
		"@types/mdx": "^2.0.13",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"axe-core": "^4.11.0",
		"axe-playwright": "^2.2.2",
		"concurrently": "^10.0.7",
		"is-in-ci": "^2.0.0",
		"lefthook": "^2.2.2",
		"npm-run-all2": "^9.1.0",
		"oxfmt": "^0.80.0",
		"oxlint": "^1.95.0",
		"oxlint-tsgolint": "^7.0.2008",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"schema-dts": "^2.1.0",
		"stylelint": "^18.1.0",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^4.1.17",
		"tsx": "^4.21.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6",
		"unified": "^11.0.5"
	},
	"browserslist": {
		"development": [
			"baseline newly available"
		],
		"production": [
			"baseline widely available"
		]
	},
	"stylelint": {
		"extends": "@acdh-oeaw/stylelint-config"
	}
}
