---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	src: ImageMetadata;
}

const { src } = Astro.props;
const width = Math.min(src.width, 1920);
const widths = [
	...new Set(
		[480, 768, 1024, 1440, width].filter((size) => {
			return size <= width;
		}),
	),
];
---

<Image
	alt=""
	class="size-full object-cover"
	fetchpriority="high"
	format="webp"
	layout="full-width"
	loading="eager"
	quality={80}
	src={src}
	width={width}
	widths={widths}
/>
